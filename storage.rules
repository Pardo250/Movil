rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Reglas para imágenes de perfil: Cualquiera las puede leer, solo el usuario dueño puede subir/modificar la suya.
    match /profile_images/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Reglas para imágenes de reseñas: Cualquiera las puede leer, solo el usuario autenticado dueño de la reseña puede subirla.
    match /users/{userId}/reviews/{imageName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
